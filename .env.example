# Get a key at https://console.anthropic.com  → put it here, then rename this file to .env.local
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Optional — enables the "Listen" button (OpenAI text-to-speech).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx

# How many of the most recent episodes to pull when given a channel/playlist
MAX_EPISODES=10

# ── Production only (Vercel) ──────────────────────────────────────────────────
# Captions in prod come from Supadata (yt-dlp can't run on Vercel). Leave unset
# locally to use the local yt-dlp path. Get a key at https://supadata.ai
# SUPADATA_API_KEY=

# Vercel KV (Upstash) for the cache in prod. Auto-injected when you link a KV
# store to the Vercel project; leave unset locally to use the .cache/ file cache.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
